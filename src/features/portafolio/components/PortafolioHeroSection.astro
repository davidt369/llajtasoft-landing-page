---
import { PORTAFOLIO_HERO } from '../constants/labels';
---

<section class="section-hero">
  <div class="section-pattern"><div class="section-pattern-grid"></div></div>

  <div class="section-container">
    <div class="section-header">
      <span class="eyebrow">{PORTAFOLIO_HERO.BADGE}</span>
      <h2 class="section-title">{PORTAFOLIO_HERO.TITLE}</h2>
      <div class="accent-divider"></div>
      <p class="section-copy">
        {PORTAFOLIO_HERO.SUBTITLE}
      </p>
    </div>
  </div>
</section>
