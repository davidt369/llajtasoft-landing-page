---
import { SUCCESS_CASES } from '../constants/labels';

const iconPaths: Record<string, string> = {
  blue: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  purple: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  teal: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
};
---

<section class="py-20 px-4 bg-gradient-to-b from-gray-950 via-gray-900 to-gray-800 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>
  
  <!-- Decorative elements -->
  <div class="absolute -top-24 -right-24 w-48 h-48 bg-blue-600/20 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-purple-600/20 rounded-full blur-3xl"></div>
  
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16 relative">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-white uppercase bg-blue-400/10 rounded-full mb-4">{SUCCESS_CASES.BADGE}</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">{SUCCESS_CASES.TITLE}</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto mb-6"></div>
      <p class="text-gray-300 max-w-3xl mx-auto text-lg">
        {SUCCESS_CASES.SUBTITLE}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {SUCCESS_CASES.ITEMS.map((item) => (
        <div class={`group bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:shadow-${item.accentColor}-500/20 border border-gray-800 hover:border-${item.accentColor}-500/30 p-8`}>
          <div class={`w-16 h-16 mx-auto bg-${item.accentColor}-500/20 rounded-full flex items-center justify-center mb-6`}>
            <svg xmlns="http://www.w3.org/2000/svg" class={`h-8 w-8 text-${item.accentColor}-400`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[item.accentColor]} />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-4 text-center">{item.title}</h3>
          <p class="text-gray-300 text-center">
            {item.description}
          </p>
        </div>
      ))}
    </div>
    
    <div class="text-center">
      <a 
        href={SUCCESS_CASES.CTA_HREF} 
        class="inline-flex h-12 items-center justify-center rounded-full bg-gradient-to-r from-blue-600 to-purple-600 px-8 text-base font-medium text-white shadow-lg transition-all hover:shadow-blue-500/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
      >
        {SUCCESS_CASES.CTA_TEXT}
      </a>
    </div>
  </div>
</section>
