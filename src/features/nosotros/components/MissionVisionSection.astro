---
import { MISSION_VISION } from '../constants/labels';
---

<section class="py-20 px-4 bg-gray-900 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>
  
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Misión -->
      <div class="group bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:shadow-blue-500/20 border border-gray-800 hover:border-blue-500/30">
        <div class="p-8">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-blue-500/20 text-white mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white">{MISSION_VISION.MISSION.TITLE}</h3>
          </div>
          
          <p class="text-gray-300 leading-relaxed">
            {MISSION_VISION.MISSION.DESCRIPTION}
          </p>
        </div>
      </div>
      
      <!-- Visión -->
      <div class="group bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:shadow-purple-500/20 border border-gray-800 hover:border-purple-500/30">
        <div class="p-8">
          <div class="flex items-center mb-6">
            <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-purple-500/20 text-purple-400 mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white">{MISSION_VISION.VISION.TITLE}</h3>
          </div>
          
          <p class="text-gray-300 leading-relaxed">
            {MISSION_VISION.VISION.DESCRIPTION}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
