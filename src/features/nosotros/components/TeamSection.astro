---
import { TEAM } from '../constants/labels';
---

<section class="py-20 px-4 bg-gray-900 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>
  
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16 relative">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-white uppercase bg-blue-400/10 rounded-full mb-4">{TEAM.BADGE}</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">{TEAM.TITLE}</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto mb-6"></div>
      <p class="text-gray-300 max-w-2xl mx-auto text-lg">
        {TEAM.SUBTITLE}
      </p>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      {TEAM.MEMBERS.map((member) => (
        <div class="group bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:shadow-blue-500/20 border border-gray-800 hover:border-blue-500/30 p-6 text-center">
          <div class="w-24 h-24 mx-auto rounded-full overflow-hidden mb-4 border-2 border-gray-700 group-hover:border-blue-500 transition-all duration-300">
            <img src={member.image} alt={member.name} class="w-full h-full object-cover" />
          </div>
          <h3 class="text-lg font-bold text-white">{member.name}</h3>
          <p class="text-blue-400 text-sm">{member.role}</p>
        </div>
      ))}
    </div>
  </div>
</section>
