---
import { VALUES } from '../constants/labels';

const iconMap: Record<string, string> = {
  blue: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6',
  purple: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2',
  teal: 'M22 11.08V12a10 10 0 1 1-5.93-9.14',
};
---

<section class="py-20 px-4 bg-gradient-to-b from-gray-900 to-gray-950 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>
  
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16 relative">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-white uppercase bg-blue-400/10 rounded-full mb-4">{VALUES.BADGE}</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">{VALUES.TITLE}</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto mb-6"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {VALUES.ITEMS.map((item) => (
        <div class={`group bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:shadow-${item.accentColor}-500/20 border border-gray-800 hover:border-${item.accentColor}-500/30 p-8 text-center`}>
          <div class={`w-16 h-16 mx-auto bg-${item.accentColor}-500/20 rounded-full flex items-center justify-center mb-6`}>
            <svg xmlns="http://www.w3.org/2000/svg" class={`h-8 w-8 text-${item.accentColor}-400`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconMap[item.accentColor]} />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">{item.title}</h3>
          <p class="text-gray-300">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
