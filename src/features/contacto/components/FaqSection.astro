---
import { FAQ } from '../constants/labels';
---

<section class="py-20 px-4 bg-gradient-to-b from-gray-950 via-gray-900 to-gray-800 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>
  
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16 relative">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-white uppercase bg-blue-400/10 rounded-full mb-4">{FAQ.BADGE}</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">{FAQ.TITLE}</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto mb-6"></div>
      <p class="text-gray-300 max-w-3xl mx-auto text-lg">
        {FAQ.SUBTITLE}
      </p>
    </div>
    
    <div class="max-w-4xl mx-auto space-y-6">
      {FAQ.ITEMS.map((item) => (
        <div class="bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 border border-gray-800 hover:border-blue-500/30 p-6">
          <h3 class="text-xl font-bold text-white mb-4 flex items-center">
            <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center mr-3">
              <span class="text-blue-400">Q</span>
            </div>
            {item.question}
          </h3>
          <p class="text-gray-300 pl-11">
            {item.answer}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
