---
import { CONTACT_FORM } from '../constants/labels';
---

<section id="formulario" class="section-panel">
  <div class="section-pattern opacity-5"><div class="section-pattern-grid"></div></div>

  <div class="absolute -top-24 -right-24 w-48 h-48 bg-brand-500/20 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-accent-500/20 rounded-full blur-3xl"></div>

  <div class="section-container">
    <div class="brand-card brand-card-hover p-8 md:p-12">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-white mb-4">{CONTACT_FORM.TITLE}</h2>
        <p class="text-surface-200 max-w-2xl mx-auto">
          {CONTACT_FORM.SUBTITLE}
        </p>
      </div>
      
      <form action="/submit-contact" method="POST" class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col">
            <label for="name" class="text-white font-medium mb-2 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              {CONTACT_FORM.FIELDS.NAME}
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              class="form-field" 
              required 
            />
          </div>
          
          <div class="flex flex-col">
            <label for="email" class="text-white font-medium mb-2 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {CONTACT_FORM.FIELDS.EMAIL}
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              class="form-field" 
              required 
            />
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
          <div class="flex flex-col">
            <label for="phone" class="text-white font-medium mb-2 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              {CONTACT_FORM.FIELDS.PHONE}
            </label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              class="form-field" 
            />
          </div>
          
          <div class="flex flex-col">
            <label for="company" class="text-white font-medium mb-2 flex items-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              {CONTACT_FORM.FIELDS.COMPANY}
            </label>
            <input 
              type="text" 
              id="company" 
              name="company" 
              class="form-field" 
            />
          </div>
        </div>
        
        <div class="flex flex-col mt-6">
          <label for="message" class="text-white font-medium mb-2 flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-brand-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            {CONTACT_FORM.FIELDS.MESSAGE}
          </label>
          <textarea 
            id="message" 
            name="message" 
            rows="5"
            class="form-field" 
            required
          ></textarea>
        </div>
        
        <div class="mt-8">
          <button 
            type="submit" 
            class="btn-primary w-full py-4 px-6 rounded-xl bg-gradient-to-r from-brand-600 to-accent-500 hover:from-brand-500 hover:to-accent-400 transform hover:-translate-y-0.5 hover:shadow-brand-500/30"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            {CONTACT_FORM.SUBMIT}
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
