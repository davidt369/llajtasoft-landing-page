---
import ServiceCard from './ServiceCard.astro';
import { SERVICES } from '../constants/labels';
---

<section class="py-20 px-4 relative overflow-hidden bg-gradient-to-tr from-gray-950 via-gray-800 to-gray-700">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>

  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 relative">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-white uppercase bg-blue-400/10 rounded-full mb-4">
        {SERVICES.BADGE}
      </span>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">{SERVICES.TITLE}</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto mb-6"></div>
      <p class="text-gray-300 max-w-2xl mx-auto text-lg">{SERVICES.SUBTITLE}</p>
    </div>

    <div class="space-y-16">
      {
        SERVICES.ITEMS.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            features={service.features}
            technologies={service.technologies}
            image={service.image}
            iconType={service.iconType}
            accentColor={service.accentColor}
            imageOrder={service.imageOrder}
          />
        ))
      }
    </div>
  </div>
</section>
