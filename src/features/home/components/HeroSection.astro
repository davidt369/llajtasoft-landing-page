---
import Header from '../../../shared/components/layout/Header.astro';
import AnimateLogos from '../../../shared/components/ui/AnimateLogos.astro';
import { HERO } from '../constants/labels';
---

<div id="large-header" class="cover overflow-hidden relative h-screen bg-linear-to-br from-[rgb(12,24,33)] via-[rgb(9,9,121)] to-[rgb(0,49,122)]">
  <Header />
  <canvas id="demo-canvas" aria-hidden="true"></canvas>

  <div class="absolute z-10 left-0 top-30 w-full text-white px-2 md:px-16">
    <div class="grid md:grid-cols-2 md:gap-2">
      <div class="md:order-2 py-4 flex items-center justify-center">
        <AnimateLogos />
      </div>

      <div>
        <p class="py-4 text-blue-300 text-center md:text-start">
          {HERO.TAGLINE}
        </p>
        <h1 class="py-4 font-bold text-4xl md:text-6xl text-white text-center md:text-start">
          {HERO.TITLE_PREFIX}
          <span class="bg-gradient-to-r font-extrabold text-white">
            {HERO.TITLE_HIGHLIGHT}
          </span>
        </h1>
        <p class="text-lg md:text-xl text-zinc-200 text-center md:text-start max-w-2xl">
          {HERO.SUBTITLE}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 my-4">
          <a
            href={HERO.CTA_HREF}
            class="px-8 w-full md:w-auto py-3 bg-blue-600 text-white text-center font-semibold hover:bg-blue-700 rounded-full transition-colors"
          >
            {HERO.CTA_BUTTON}
          </a>
          <a
            href={HERO.SECONDARY_CTA_HREF}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 w-full md:w-auto py-3 bg-white/10 text-white text-center font-semibold hover:bg-white/20 rounded-full border border-white/20 transition-colors"
          >
            {HERO.SECONDARY_CTA_BUTTON}
          </a>
        </div>
        <p class="text-sm text-zinc-300 text-center md:text-start">
          {HERO.MICROCOPY}
        </p>
      </div>
    </div>
  </div>
</div>
