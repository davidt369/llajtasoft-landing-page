---
import GearIcon from '../../../shared/assets/icons/GearIcon.astro';
import LightbulbIcon from '../../../shared/assets/icons/LightbulbIcon.astro';
import BoltIcon from '../../../shared/assets/icons/BoltIcon.astro';
import ArrowRightIcon from '../../../shared/assets/icons/ArrowRightIcon.astro';
import { WHY_US } from '../constants/labels';
---

<section class="text-center bg-gray-900 text-zinc-400 py-16 px-2 md:px-16 relative overflow-hidden">
  <div class="absolute inset-0 bg-[url('/images/circuit-pattern.svg')] opacity-5 animate-pulse"></div>

  <div class="max-w-5xl mx-auto relative z-10">
    <h2 class="text-3xl font-semibold mb-6 text-white">
      {WHY_US.TITLE_PREFIX}
      <span class="bg-gradient-to-r font-extrabold text-white">
        {WHY_US.TITLE_HIGHLIGHT}
      </span>?
    </h2>
    <p class="text-zinc-400 mb-8">{WHY_US.SUBTITLE}</p>

    <div class="grid md:grid-cols-3 gap-8 mb-10">
      <article class="bg-gray-800 bg-opacity-50 p-6 rounded-lg transform hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 mx-auto mb-4 bg-gradient-to-br from-blue-950 to-blue-800 rounded-full flex items-center justify-center">
          <GearIcon class="h-8 w-8 text-white" />
        </div>
        <h3 class="text-white text-xl font-semibold mb-2">Experiencia</h3>
        <p class="text-zinc-400">
          Con más de <span class="text-white font-semibold">5 años</span> de trayectoria y
          <span class="text-white font-semibold">100+ proyectos</span> exitosos.
        </p>
      </article>

      <article class="bg-gray-800 bg-opacity-50 p-6 rounded-lg transform hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 mx-auto mb-4 bg-gradient-to-br from-blue-950 to-blue-800 rounded-full flex items-center justify-center">
          <LightbulbIcon class="h-8 w-8 text-white" />
        </div>
        <h3 class="text-white text-xl font-semibold mb-2">Innovación</h3>
        <p class="text-zinc-400">
          Soluciones <span class="bg-gradient-to-r font-semibold text-white">tecnológicas</span> de vanguardia para cada desafío empresarial.
        </p>
      </article>

      <article class="bg-gray-800 bg-opacity-50 p-6 rounded-lg transform hover:scale-105 transition-all duration-300">
        <div class="w-16 h-16 mx-auto mb-4 bg-gradient-to-br from-blue-950 to-blue-800 rounded-full flex items-center justify-center">
          <BoltIcon class="h-8 w-8 text-white" />
        </div>
        <h3 class="text-white text-xl font-semibold mb-2">Agilidad</h3>
        <p class="text-zinc-400">
          Metodología <span class="text-white font-semibold">100% ágil</span> que garantiza resultados rápidos y eficientes.
        </p>
      </article>
    </div>

    <a
      href={WHY_US.CTA_HREF}
      class="group inline-flex items-center text-blue-500 hover:text-white transition-all duration-300 font-semibold"
    >
      {WHY_US.CTA}
      <ArrowRightIcon class="h-5 w-5 ml-2 transform group-hover:translate-x-1 transition-transform" />
    </a>
  </div>
</section>
