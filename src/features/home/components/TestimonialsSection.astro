---
import QuoteIcon from '../../../shared/assets/icons/QuoteIcon.astro';
import { TESTIMONIALS } from '../constants/labels';
---

<section class="text-center py-16 bg-gray-950 px-2 md:px-16 text-white relative">
  <div class="max-w-5xl mx-auto relative z-10">
    <h2 class="text-3xl font-semibold mb-8">
      {TESTIMONIALS.TITLE_PREFIX}
      <span class="bg-gradient-to-r font-extrabold text-white">
        {TESTIMONIALS.TITLE_HIGHLIGHT}
      </span>
    </h2>

    <div class="grid md:grid-cols-2 gap-8 mb-10">
      {
        TESTIMONIALS.ITEMS.map((testimonial) => (
          <article
            class={`bg-gray-900 bg-opacity-60 p-6 rounded-lg shadow-xl transform hover:shadow-${testimonial.accentColor}/10 hover:scale-105 transition-all duration-300 relative overflow-hidden`}
          >
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-24 h-24 opacity-10">
              <QuoteIcon class={`h-full w-full text-${testimonial.accentColor}`} />
            </div>

            <div class="flex items-center mb-4">
              <div class="h-12 w-12 rounded-full bg-gradient-to-br from-blue-950 to-blue-800 flex items-center justify-center text-white font-bold mr-4">
                {testimonial.initials}
              </div>
              <div class="text-left">
                <h4 class="font-semibold">{testimonial.name}</h4>
                <p class="text-zinc-400 text-sm">{testimonial.role}</p>
              </div>
            </div>

            <p class="italic mb-4 text-zinc-300">
              "{testimonial.quote}{' '}
              <span class="bg-gradient-to-r font-semibold text-white">
                {testimonial.highlight}
              </span>{' '}
              {testimonial.quoteSuffix}"
            </p>

            <div class="flex justify-center">
              <span class="text-yellow-500">{'★'.repeat(testimonial.rating)}</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
