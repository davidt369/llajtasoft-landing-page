---
import CheckCircleIcon from '../../../shared/assets/icons/CheckCircleIcon.astro';
import { PAINS } from '../constants/labels';
---

<section class="bg-gray-950 py-16 px-4 md:px-16 text-white">
  <div class="max-w-6xl mx-auto">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-blue-200 uppercase bg-blue-500/10 rounded-full mb-4">
        Procesos desordenados cuestan dinero
      </span>
      <h2 class="text-3xl md:text-5xl font-bold mb-4">{PAINS.TITLE}</h2>
      <p class="text-gray-400 text-lg">{PAINS.SUBTITLE}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
      {
        PAINS.ITEMS.map((pain) => (
          <article class="bg-gray-900/80 border border-gray-800 rounded-2xl p-5 flex gap-3">
            <CheckCircleIcon class="h-5 w-5 text-blue-300 shrink-0 mt-1" />
            <p class="text-gray-300">{pain}</p>
          </article>
        ))
      }
    </div>

    <div class="max-w-3xl mx-auto text-center bg-blue-500/10 border border-blue-500/20 rounded-2xl p-6">
      <p class="text-blue-100 font-semibold">{PAINS.CLOSING}</p>
    </div>
  </div>
</section>
