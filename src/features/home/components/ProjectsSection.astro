---
import { PROJECTS } from '../constants/labels';
---

<section class="text-center bg-gray-800 py-16 px-2 md:px-16 relative overflow-hidden">
  <div class="max-w-5xl mx-auto relative z-10">
    <h2 class="text-3xl font-semibold mb-8 text-white">
      {PROJECTS.TITLE_PREFIX}
      <span class="bg-gradient-to-r font-extrabold text-white">
        {PROJECTS.TITLE_HIGHLIGHT}
      </span>
    </h2>
    <p class="text-gray-400 mb-10">{PROJECTS.SUBTITLE}</p>
    <div class="grid md:grid-cols-3 gap-8">
      {
        PROJECTS.ITEMS.map((project) => (
          <article class="bg-gray-900 rounded-lg overflow-hidden shadow-lg transform hover:scale-105 transition-all duration-300">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-48 object-cover"
              loading="lazy"
            />
            <div class="p-6">
              <h3 class="text-xl font-bold text-white">{project.title}</h3>
              <p class="text-gray-400 mt-2">{project.description}</p>
              <a
                href={project.link}
                class="inline-block mt-4 text-blue-500 hover:text-white font-semibold transition-colors"
              >
                {project.linkText}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
