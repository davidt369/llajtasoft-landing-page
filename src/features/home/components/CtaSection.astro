---
import ArrowRightIcon from '../../../shared/assets/icons/ArrowRightIcon.astro';
import { CTA } from '../constants/labels';
---

<section class="text-center py-16 bg-gray-900 px-2 md:px-16 text-white relative overflow-hidden">
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-b from-gray-900 to-gray-800 opacity-90"></div>
  </div>

  <div class="max-w-5xl mx-auto relative z-10">
    <h2 class="text-3xl font-semibold mb-6">
      {CTA.TITLE_PREFIX}
      <span class="bg-gradient-to-r font-extrabold text-white">
        {CTA.TITLE_HIGHLIGHT}
      </span>?
    </h2>

    <div class="mb-10 max-w-3xl mx-auto">
      <p class="text-lg mb-8 text-zinc-300">{CTA.SUBTITLE}</p>

      <div class="grid md:grid-cols-3 gap-4 mb-8">
        {
          CTA.STATS.map((stat) => (
            <div class="bg-gray-800 bg-opacity-50 p-4 rounded-lg">
              <div class="text-3xl font-bold text-gradient bg-gradient-to-r text-white">
                {stat.value}
              </div>
              <p class="text-zinc-400 text-sm">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center justify-center gap-4">
      <a
        href={CTA.CTA_HREF}
        class="group bg-blue-500 text-white py-3 px-8 rounded-full hover:shadow-lg hover:shadow-blue-950 transform hover:-translate-y-1 transition-all duration-300 font-semibold"
      >
        <span class="flex items-center">
          {CTA.CTA_BUTTON}
          <ArrowRightIcon class="h-5 w-5 ml-2 transform group-hover:translate-x-1 transition-transform" />
        </span>
      </a>
    </div>
  </div>
</section>
