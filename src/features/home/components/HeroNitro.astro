---
import { HERO } from '../constants/labels';
import { Player } from '@remotion/player';
import ProductPresentation from '../../remotion/ProductPresentation';

const STACK = [
  { label: 'Web', icon: '🌐' },
  { label: 'Móvil', icon: '📱' },
  { label: 'Escritorio', icon: '💻' },
  { label: 'API & Integraciones', icon: '🔌' },
  { label: 'Dashboards', icon: '📊' },
  { label: 'Automatización', icon: '⚙️' },
];
---

<section class="hero-nitro">
  <!-- Glow background -->
  <div class="hero-nitro__bg" aria-hidden="true">
    <div class="hero-nitro__glow hero-nitro__glow--brand"></div>
    <div class="hero-nitro__glow hero-nitro__glow--accent"></div>
    <div class="hero-nitro__grid"></div>
  </div>

  <div class="hero-nitro__container">
    <!-- Eyebrow -->
    <a href="/servicios" class="hero-nitro__eyebrow">
      <span class="hero-nitro__eyebrow-pill">Nuevo</span>
      <span class="hero-nitro__eyebrow-text">{HERO.TAGLINE}</span>
      <svg class="hero-nitro__eyebrow-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </a>

    <!-- Title -->
    <h1 class="hero-nitro__title">
      {HERO.TITLE_PREFIX}{' '}
      <span class="hero-nitro__highlight">{HERO.TITLE_HIGHLIGHT}</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-nitro__subtitle">{HERO.SUBTITLE}</p>

    <!-- CTAs -->
    <div class="hero-nitro__ctas">
      <a href={HERO.CTA_HREF} class="hero-nitro__cta hero-nitro__cta--primary">
        {HERO.CTA_BUTTON}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
      <a href={HERO.SECONDARY_CTA_HREF} target="_blank" rel="noopener noreferrer" class="hero-nitro__cta hero-nitro__cta--secondary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {HERO.SECONDARY_CTA_BUTTON}
      </a>
    </div>

    <p class="hero-nitro__microcopy">{HERO.MICROCOPY}</p>

    <!-- Product presentation video -->
    <div class="hero-nitro__video-container">
      <div class="hero-nitro__video-glow"></div>
      <div class="hero-nitro__player-wrapper">
        <Player
          component={ProductPresentation}
          durationInFrames={180}
          compositionWidth={1920}
          compositionHeight={1080}
          fps={30}
          controls
          loop
          style={{
            width: '100%',
            height: '100%',
            borderRadius: '1rem',
          }}
        />
      </div>

      <!-- Stack pills -->
      <ul class="hero-nitro__stack">
        {STACK.map((s) => (
          <li class="hero-nitro__chip">
            <span class="hero-nitro__chip-icon">{s.icon}</span>
            {s.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero-nitro {
    @apply relative min-h-[90vh] flex items-center justify-center px-4 overflow-hidden;
    background:
      radial-gradient(circle at top left, var(--brand-glow), transparent 40rem),
      radial-gradient(circle at bottom right, var(--accent-glow), transparent 35rem),
      linear-gradient(180deg, var(--bg-page) 0%, var(--bg-section) 100%);
  }

  .hero-nitro__bg {
    @apply absolute inset-0 pointer-events-none;
  }

  .hero-nitro__glow {
    @apply absolute rounded-full blur-3xl opacity-40;
  }

  .hero-nitro__glow--brand {
    @apply w-[600px] h-[600px] -top-48 -left-48 bg-brand-500;
    animation: float 8s ease-in-out infinite;
  }

  .hero-nitro__glow--accent {
    @apply w-[500px] h-[500px] -bottom-32 -right-32 bg-accent-500;
    animation: float 10s ease-in-out infinite reverse;
  }

  .hero-nitro__grid {
    @apply absolute inset-0 bg-[radial-gradient(rgba(148,163,184,0.08)_1px,transparent_1px)] bg-[size:32px_32px];
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -30px) scale(1.05); }
  }

  .hero-nitro__container {
    @apply max-w-6xl mx-auto relative z-10 text-center;
  }

  .hero-nitro__eyebrow {
    @apply inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-500/10 border border-brand-400/20 text-brand-200 text-sm font-medium hover:bg-brand-500/15 transition-colors;
  }

  .hero-nitro__eyebrow-pill {
    @apply px-2 py-0.5 rounded-full bg-brand-500 text-white text-xs font-semibold;
  }

  .hero-nitro__eyebrow-arrow {
    @apply transition-transform group-hover:translate-x-0.5;
  }

  .hero-nitro__title {
    @apply text-4xl md:text-5xl lg:text-6xl font-bold mt-8 mb-6 leading-tight tracking-tight;
  }

  .hero-nitro__highlight {
    @apply bg-gradient-to-r from-brand-400 to-accent-400 bg-clip-text text-transparent;
  }

  .hero-nitro__subtitle {
    @apply text-lg md:text-xl text-surface-300 max-w-3xl mx-auto mb-10 leading-relaxed;
  }

  .hero-nitro__ctas {
    @apply flex flex-col sm:flex-row items-center justify-center gap-4 mb-8;
  }

  .hero-nitro__cta {
    @apply inline-flex items-center gap-2 px-8 py-3.5 rounded-full text-base font-semibold transition-all;
  }

  .hero-nitro__cta--primary {
    @apply bg-brand-600 text-white shadow-lg shadow-brand-950/40 hover:bg-brand-500 hover:shadow-brand-950/60;
  }

  .hero-nitro__cta--secondary {
    @apply bg-white/10 text-white border border-surface-600 hover:bg-white/15 hover:border-brand-400/40;
  }

  .hero-nitro__microcopy {
    @apply text-sm text-surface-400 mb-16;
  }

  .hero-nitro__video-container {
    @apply relative max-w-4xl mx-auto mt-12;
  }

  .hero-nitro__video-glow {
    @apply absolute inset-0 bg-gradient-to-r from-brand-500/20 to-accent-500/20 blur-3xl -z-10;
  }

  .hero-nitro__player-wrapper {
    @apply relative bg-surface-900/90 backdrop-blur-xl rounded-2xl border border-surface-700/80 shadow-2xl overflow-hidden;
    aspect-video;
  }

  .hero-nitro__stack {
    @apply flex flex-wrap items-center justify-center gap-3 mt-6;
  }

  .hero-nitro__chip {
    @apply flex items-center gap-2 px-4 py-2 rounded-full bg-surface-800/80 border border-surface-700/80 text-sm text-surface-300 hover:border-brand-400/40 transition-colors;
  }

  .hero-nitro__chip-icon {
    @apply text-lg;
  }

  @media (max-width: 768px) {
    .hero-nitro__title {
      @apply text-3xl md:text-4xl;
    }

    .hero-nitro__subtitle {
      @apply text-base;
    }

    .hero-nitro__window-body {
      @apply p-4;
    }

    .hero-nitro__code {
      @apply text-xs;
    }
  }
</style>
