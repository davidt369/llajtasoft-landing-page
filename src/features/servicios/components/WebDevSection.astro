---
import { WEB_DEVELOPMENT } from '../constants/labels';

const iconPaths: Record<string, string> = {
  blue: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  purple: 'M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z',
  teal: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
};
---

<section class="py-20 px-4 bg-gray-900 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>
  
  <!-- Decorative element -->
  <div class="absolute -top-24 -right-24 w-48 h-48 bg-blue-600/20 rounded-full blur-3xl"></div>
  
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16 relative">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-blue-400 uppercase bg-blue-400/10 rounded-full mb-4">{WEB_DEVELOPMENT.BADGE}</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">{WEB_DEVELOPMENT.TITLE}</h2>
      <div class={`w-24 h-1 bg-gradient-to-r ${WEB_DEVELOPMENT.GRADIENT} mx-auto mb-6`}></div>
      <p class="text-gray-300 max-w-2xl mx-auto text-lg">
        {WEB_DEVELOPMENT.SUBTITLE}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {WEB_DEVELOPMENT.ITEMS.map((item) => (
        <div class={`group bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:shadow-${item.accentColor}-500/20 border border-gray-800 hover:border-${item.accentColor}-500/30 p-8`}>
          <div class={`w-12 h-12 flex items-center justify-center rounded-xl bg-${item.accentColor}-500/20 text-${item.accentColor}-400 mb-6`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[item.accentColor]} />
            </svg>
          </div>
          <h3 class={`text-xl font-bold text-white mb-4 group-hover:text-${item.accentColor}-400 transition-colors duration-300`}>{item.title}</h3>
          <p class="text-gray-300">
            {item.description}
          </p>
        </div>
      ))}
    </div>
    
    <div class="text-center">
      <a 
        href={WEB_DEVELOPMENT.CTA_HREF} 
        class={`inline-flex h-12 items-center justify-center rounded-full bg-${WEB_DEVELOPMENT.CTA_COLOR}-600 px-8 text-base font-medium text-white shadow-lg transition-colors hover:bg-${WEB_DEVELOPMENT.CTA_COLOR}-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-${WEB_DEVELOPMENT.CTA_COLOR}-500`}
      >
        {WEB_DEVELOPMENT.CTA_TEXT}
      </a>
    </div>
  </div>
</section>
