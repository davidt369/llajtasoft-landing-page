---
import { MOBILE_DEVELOPMENT } from '../constants/labels';

const iconPaths: Record<string, string> = {
  purple: 'M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z',
  blue: 'M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z',
};
---

<section class="py-20 px-4 bg-gradient-to-b from-gray-950 via-gray-900 to-gray-800 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>
  
  <!-- Decorative element -->
  <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-purple-600/20 rounded-full blur-3xl"></div>
  
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16 relative">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-purple-400 uppercase bg-purple-400/10 rounded-full mb-4">{MOBILE_DEVELOPMENT.BADGE}</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">{MOBILE_DEVELOPMENT.TITLE}</h2>
      <div class={`w-24 h-1 bg-gradient-to-r ${MOBILE_DEVELOPMENT.GRADIENT} mx-auto mb-6`}></div>
      <p class="text-gray-300 max-w-2xl mx-auto text-lg">
        {MOBILE_DEVELOPMENT.SUBTITLE}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {MOBILE_DEVELOPMENT.ITEMS.map((item) => (
        <div class={`group bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:shadow-${item.accentColor}-500/20 border border-gray-800 hover:border-${item.accentColor}-500/30 p-8`}>
          <div class={`w-12 h-12 flex items-center justify-center rounded-xl bg-${item.accentColor}-500/20 text-${item.accentColor}-400 mb-6`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[item.accentColor]} />
            </svg>
          </div>
          <h3 class={`text-xl font-bold text-white mb-4 group-hover:text-${item.accentColor}-400 transition-colors duration-300`}>{item.title}</h3>
          <p class="text-gray-300">
            {item.description}
          </p>
          <ul class="text-gray-300 space-y-2 mt-6">
            {item.features.map((feature) => (
              <li class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class={`h-5 w-5 text-${item.accentColor}-400 mr-2`} viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    
    <div class="text-center">
      <a 
        href={MOBILE_DEVELOPMENT.CTA_HREF} 
        class={`inline-flex h-12 items-center justify-center rounded-full bg-${MOBILE_DEVELOPMENT.CTA_COLOR}-600 px-8 text-base font-medium text-white shadow-lg transition-colors hover:bg-${MOBILE_DEVELOPMENT.CTA_COLOR}-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-${MOBILE_DEVELOPMENT.CTA_COLOR}-500`}
      >
        {MOBILE_DEVELOPMENT.CTA_TEXT}
      </a>
    </div>
  </div>
</section>
