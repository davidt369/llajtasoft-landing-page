---
import { PROCESS } from '../constants/labels';

const iconPaths: Record<string, string> = {
  blue: 'M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z',
  purple: 'M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z',
  teal: 'M5 13l4 4L19 7',
  amber: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
};
---

<section class="py-20 px-4 bg-gradient-to-b from-gray-950 via-gray-900 to-gray-800 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>
  
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16 relative">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-white uppercase bg-blue-400/10 rounded-full mb-4">{PROCESS.BADGE}</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">{PROCESS.TITLE}</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-blue-500 to-purple-500 mx-auto mb-6"></div>
      <p class="text-gray-300 max-w-3xl mx-auto text-lg">
        {PROCESS.SUBTITLE}
      </p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      {PROCESS.STEPS.map((step) => (
        <div class={`group bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:shadow-${step.accentColor}-500/20 border border-gray-800 hover:border-${step.accentColor}-500/30 p-8`}>
          <div class={`w-12 h-12 flex items-center justify-center rounded-xl bg-${step.accentColor}-500/20 text-${step.accentColor}-400 mb-6`}>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[step.accentColor]} />
            </svg>
          </div>
          <h3 class={`text-xl font-bold text-white mb-4 group-hover:text-${step.accentColor}-400 transition-colors duration-300`}>{step.title}</h3>
          <p class="text-gray-300">
            {step.description}
          </p>
        </div>
      ))}
    </div>
    
    <div class="text-center">
      <a 
        href={PROCESS.CTA_HREF} 
        class="inline-flex h-12 items-center justify-center rounded-full bg-blue-600 px-8 text-base font-medium text-white shadow-lg transition-colors hover:bg-blue-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
      >
        {PROCESS.CTA_TEXT}
      </a>
    </div>
  </div>
</section>
