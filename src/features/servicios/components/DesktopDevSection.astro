---
import { DESKTOP_DEVELOPMENT } from '../constants/labels';
---

<section class="py-20 px-4 bg-gray-900 relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>
  
  <!-- Decorative element -->
  <div class="absolute -top-24 -left-24 w-48 h-48 bg-teal-600/20 rounded-full blur-3xl"></div>
  
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16 relative">
      <span class="inline-block px-3 py-1 text-xs font-medium tracking-wider text-teal-400 uppercase bg-teal-400/10 rounded-full mb-4">{DESKTOP_DEVELOPMENT.BADGE}</span>
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-white">{DESKTOP_DEVELOPMENT.TITLE}</h2>
      <div class={`w-24 h-1 bg-gradient-to-r ${DESKTOP_DEVELOPMENT.GRADIENT} mx-auto mb-6`}></div>
      <p class="text-gray-300 max-w-2xl mx-auto text-lg">
        {DESKTOP_DEVELOPMENT.SUBTITLE}
      </p>
    </div>
    
    <div class="max-w-3xl mx-auto mb-16">
      <div class="group bg-gray-900/80 backdrop-blur-sm rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:shadow-teal-500/20 border border-gray-800 hover:border-teal-500/30">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="p-8 flex flex-col justify-center">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-teal-500/20 text-teal-400 mr-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 13.5l3 3m0 0l3-3m-3 3v-6m1.06-4.19l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-white group-hover:text-teal-400 transition-colors duration-300">{DESKTOP_DEVELOPMENT.CARD.title}</h3>
            </div>
            
            <p class="text-gray-300 mb-6">
              {DESKTOP_DEVELOPMENT.CARD.description}
            </p>
            
            <ul class="text-gray-300 space-y-2 mb-6">
              {DESKTOP_DEVELOPMENT.CARD.features.map((feature) => (
                <li class="flex items-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-teal-400 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
          
          <div class="relative h-64 md:h-auto overflow-hidden">
            <img
              src={DESKTOP_DEVELOPMENT.CARD.image}
              alt={DESKTOP_DEVELOPMENT.CARD.imageAlt}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent opacity-70"></div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="text-center">
      <a 
        href={DESKTOP_DEVELOPMENT.CTA_HREF} 
        class={`inline-flex h-12 items-center justify-center rounded-full bg-${DESKTOP_DEVELOPMENT.CTA_COLOR}-600 px-8 text-base font-medium text-white shadow-lg transition-colors hover:bg-${DESKTOP_DEVELOPMENT.CTA_COLOR}-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-${DESKTOP_DEVELOPMENT.CTA_COLOR}-500`}
      >
        {DESKTOP_DEVELOPMENT.CTA_TEXT}
      </a>
    </div>
  </div>
</section>
