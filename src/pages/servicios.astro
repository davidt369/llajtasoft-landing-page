---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../shared/constants/site";
import ServiciosHeroSection from "../features/servicios/components/ServiciosHeroSection.astro";
import WebDevSection from "../features/servicios/components/WebDevSection.astro";
import MobileDevSection from "../features/servicios/components/MobileDevSection.astro";
import DesktopDevSection from "../features/servicios/components/DesktopDevSection.astro";
import ProcessSection from "../features/servicios/components/ProcessSection.astro";
import ServiciosCtaSection from "../features/servicios/components/ServiciosCtaSection.astro";
---

<MainLayout
  title={`Servicios | ${SITE.COMPANY_NAME}`}
  description="Servicios de desarrollo web, móvil y de escritorio. Soluciones tecnológicas personalizadas para tu negocio."
>
  <ServiciosHeroSection />

  <WebDevSection />
  <MobileDevSection />
  <DesktopDevSection />
  <ProcessSection />
  <ServiciosCtaSection />

  <script>
    import { initializeAnimation } from "../scripts/animate.js";
    initializeAnimation();
  </script>
</MainLayout>