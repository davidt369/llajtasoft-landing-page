---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../shared/constants/site";
import ContactHeroSection from "../features/contacto/components/ContactHeroSection.astro";
import ContactFormSection from "../features/contacto/components/ContactFormSection.astro";
import ContactInfoSection from "../features/contacto/components/ContactInfoSection.astro";
import SocialMediaSection from "../features/contacto/components/SocialMediaSection.astro";
import FaqSection from "../features/contacto/components/FaqSection.astro";
import ContactoCtaSection from "../features/contacto/components/ContactoCtaSection.astro";
---

<MainLayout
  title={`Contacto | ${SITE.COMPANY_NAME}`}
  description="Contáctanos para hablar sobre tu proyecto. Estamos listos para ayudarte a crecer con soluciones tecnológicas."
>
  <ContactHeroSection />
  <ContactFormSection />
  <ContactInfoSection />
  <SocialMediaSection />
  <FaqSection />
  <ContactoCtaSection />

  <script>
    import { initializeAnimation } from "../scripts/animate.js";
    initializeAnimation();
  </script>
</MainLayout>