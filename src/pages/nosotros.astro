---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../shared/constants/site";
import AboutHeroSection from "../features/nosotros/components/AboutHeroSection.astro";
import MissionVisionSection from "../features/nosotros/components/MissionVisionSection.astro";
import ValuesSection from "../features/nosotros/components/ValuesSection.astro";
import TeamSection from "../features/nosotros/components/TeamSection.astro";
import WhyChooseUsSection from "../features/nosotros/components/WhyChooseUsSection.astro";
import NosotrosCtaSection from "../features/nosotros/components/NosotrosCtaSection.astro";
---

<MainLayout
  title={`Nosotros | ${SITE.COMPANY_NAME}`}
  description="Conoce al equipo de Llajtasoft. Transformamos ideas en soluciones tecnológicas de alta calidad."
>
  <AboutHeroSection />
  <MissionVisionSection />
  <ValuesSection />
  <TeamSection />
  <WhyChooseUsSection />
  <NosotrosCtaSection />

  <script>
    import { initializeAnimation } from "../scripts/animate.js";
    initializeAnimation();
  </script>
</MainLayout>