---
import MainLayout from "../../layouts/MainLayout.astro";
import { SITE } from "../../shared/constants/site";
import { getCollection } from "astro:content";
import FeaturedPostsSection from "../../features/blog/components/FeaturedPostsSection.astro";
import AllPostsSection from "../../features/blog/components/AllPostsSection.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPosts = posts.slice(0, 2);
---

<MainLayout
  title={`Blog | ${SITE.COMPANY_NAME}`}
  description="Artículos y recursos sobre desarrollo de software, producto digital, tecnología y transformación digital."
>
  <FeaturedPostsSection posts={featuredPosts} />
  <AllPostsSection posts={posts} />

  <script>
    import { initializeAnimation } from "../../scripts/animate.js";
    initializeAnimation();
  </script>
</MainLayout>