---
import MainLayout from "../layouts/MainLayout.astro";
import { SITE } from "../shared/constants/site";
import PortafolioHeroSection from "../features/portafolio/components/PortafolioHeroSection.astro";
import ProjectsGridSection from "../features/portafolio/components/ProjectsGridSection.astro";
import SuccessCasesSection from "../features/portafolio/components/SuccessCasesSection.astro";
import PortafolioCtaSection from "../features/portafolio/components/PortafolioCtaSection.astro";
---

<MainLayout
  title={`Portafolio | ${SITE.COMPANY_NAME}`}
  description="Conoce nuestros proyectos destacados. Soluciones tecnológicas a medida que generan impacto real."
>
  <PortafolioHeroSection />
  <ProjectsGridSection />
  <SuccessCasesSection />
  <PortafolioCtaSection />

  <script>
    import { initializeAnimation } from "../scripts/animate.js";
    initializeAnimation();
  </script>
</MainLayout>
