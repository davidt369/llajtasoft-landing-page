---
import FooterServiceIcon from '../../assets/icons/FooterServiceIcon.astro';
import type { FooterLink } from '../../constants/footer';

interface Props {
  title: string;
  links: readonly FooterLink[];
}
const { title, links } = Astro.props;
---

<div class="p-6">
  <div class="flex items-center gap-3 mb-5">
    <h5 class="font-semibold text-xl text-white">{title}</h5>
  </div>
  <ul class="space-y-3">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="group flex items-center gap-2 text-gray-400 hover:text-blue-400 transition-colors duration-300"
          >
            <FooterServiceIcon
              name={link.icon}
              class="h-4 w-4 text-blue-500 group-hover:text-blue-400"
            />
            <span>{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
