---
import FooterBrand from './FooterBrand.astro';
import FooterLinkList from './FooterLinkList.astro';
import FooterSocial from './FooterSocial.astro';
import FooterContact from './FooterContact.astro';
import { SITE } from '../../constants/site';
import {
  FOOTER_LABELS,
  FOOTER_SERVICES,
  FOOTER_INFO,
  FOOTER_LEGAL,
} from '../../constants/footer';

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-gradient-to-b from-zinc-950 to-black text-white md:p-16 px-2 overflow-hidden">
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff33_1px,transparent_1px)] bg-[size:20px_20px]"></div>
  </div>

  <div class="absolute -top-24 -right-24 w-48 h-48 bg-blue-600/20 rounded-full blur-3xl"></div>
  <div class="absolute -bottom-24 -left-24 w-48 h-48 bg-blue-600/10 rounded-full blur-3xl"></div>

  <div class="container mx-auto px-6 relative z-10">
    <FooterBrand />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <FooterLinkList title={FOOTER_LABELS.SERVICES_TITLE} links={FOOTER_SERVICES} />
      <FooterLinkList title={FOOTER_LABELS.INFO_TITLE} links={FOOTER_INFO} />
      <FooterSocial />
      <FooterContact />
    </div>

    <div class="border-t border-gray-800/50 pt-8 text-center">
      <div class="flex flex-wrap justify-center gap-6 mb-6">
        {
          FOOTER_LEGAL.map((item) => (
            <a
              href={item.href}
              class="text-sm text-gray-500 hover:text-blue-400 transition-colors duration-300"
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <p class="text-gray-500 text-sm">
        &copy; {currentYear} {SITE.TITLE}. {FOOTER_LABELS.COPYRIGHT_SUFFIX}
      </p>
    </div>
  </div>
</footer>
