---
import LogoIcon from '../../assets/icons/LogoIcon.astro';
import { SITE } from '../../constants/site';
import { FOOTER_LABELS } from '../../constants/footer';
---

<div class="max-w-3xl mx-auto mb-16 text-center">
  <a href="/" class="inline-flex items-center justify-center gap-3 mb-6 group">
    <div class="relative transition-transform duration-300 group-hover:scale-110">
      <LogoIcon class="drop-shadow-[0_0_15px_rgba(47,69,255,0.5)]" />
      <div class="absolute inset-0 bg-blue-500/20 blur-xl rounded-full -z-10"></div>
    </div>
    <span class="text-3xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-blue-200">
      {SITE.TITLE}
    </span>
  </a>
  <p class="text-lg text-gray-400 leading-relaxed max-w-2xl mx-auto">
    {FOOTER_LABELS.BRAND_DESCRIPTION}
  </p>
</div>
